    <table cellpadding="0" cellspacing="0" border="0" width="100%">
    <tr>
        <td id="descriptionArea">
            <div class='table-wrap'>
<table class='confluenceTable'><tbody>
<tr>
<td class='confluenceTd'>1</td>
<td class='confluenceTd'><tt>cp</tt></td>
<td class='confluenceTd'>Copies files or directories</td>
<td class='confluenceTd'><tt>cp notes.txt backup.txt</tt> (add <tt>-r</tt> to copy a folder)</td>
</tr>
<tr>
<td class='confluenceTd'>2</td>
<td class='confluenceTd'><tt>mv</tt></td>
<td class='confluenceTd'>Moves or renames files</td>
<td class='confluenceTd'><tt>mv old.txt new.txt</tt> or <tt>mv file.txt /tmp/</tt></td>
</tr>
<tr>
<td class='confluenceTd'>3</td>
<td class='confluenceTd'><tt>touch</tt></td>
<td class='confluenceTd'>Creates an empty file, or updates a file’s timestamp</td>
<td class='confluenceTd'><tt>touch newfile.txt</tt></td>
</tr>
<tr>
<td class='confluenceTd'>4</td>
<td class='confluenceTd'><tt>cat</tt></td>
<td class='confluenceTd'>Prints a file’s contents to the screen</td>
<td class='confluenceTd'><tt>cat /etc/hosts</tt></td>
</tr>
<tr>
<td class='confluenceTd'>5</td>
<td class='confluenceTd'><tt>less</tt></td>
<td class='confluenceTd'>Lets you scroll through a long file page by page (q to quit)</td>
<td class='confluenceTd'><tt>less /var/log/syslog</tt></td>
</tr>
<tr>
<td class='confluenceTd'>6</td>
<td class='confluenceTd'><tt>head</tt></td>
<td class='confluenceTd'>Shows the first lines of a file (10 by default)</td>
<td class='confluenceTd'><tt>head -n 5 file.txt</tt></td>
</tr>
<tr>
<td class='confluenceTd'>7</td>
<td class='confluenceTd'><tt>tail</tt></td>
<td class='confluenceTd'>Shows the last lines of a file; <tt>-f</tt> follows new lines live</td>
<td class='confluenceTd'><tt>tail -f /var/log/syslog</tt></td>
</tr>
<tr>
<td class='confluenceTd'>8</td>
<td class='confluenceTd'><tt>grep</tt></td>
<td class='confluenceTd'>Searches for text patterns inside files</td>
<td class='confluenceTd'><tt>grep "error" app.log</tt></td>
</tr>
<tr>
<td class='confluenceTd'>9</td>
<td class='confluenceTd'><tt>find</tt></td>
<td class='confluenceTd'>Searches for files and directories by name, type, size, etc.</td>
<td class='confluenceTd'><tt>find /home -name "*.txt"</tt></td>
</tr>
<tr>
<td class='confluenceTd'>10</td>
<td class='confluenceTd'><tt>echo</tt></td>
<td class='confluenceTd'>Prints text, or writes it into a file with redirection</td>
<td class='confluenceTd'><tt>echo "Hello" &gt; hello.txt</tt></td>
</tr>
</tbody></table>
</div>

